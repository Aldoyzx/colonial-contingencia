{
  "name": "colonial-contingencia-server",
  "version": "1.0.0",
  "description": "API del sistema de gestión de contingencia ante ransomware (caso Colonial Pipeline 2021) sobre PostgreSQL",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.js\"",
    "db:reset": "node --env-file-if-exists=.env src/db/reset.js",
    "db:demo": "node --env-file-if-exists=.env src/db/reset.js --demo",
    "db:generate-seed": "node scripts/generate-seed-sql.js",
    "simulacro": "node --env-file-if-exists=.env scripts/simulacro.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  }
}
